{
  "$defs": {
    "ActorIdentity": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorIdentity",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "OPERATOR",
        "SCHEDULER",
        "WORKER",
        "RECOVERY",
        "SYSTEM"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "JobState": {
      "enum": [
        "QUEUED",
        "CLAIMED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "BLOCKED",
        "TIMED_OUT",
        "CANCEL_REQUESTED",
        "CANCELLED"
      ],
      "title": "JobState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorIdentity"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "from_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobState"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
      "title": "Reason Code",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "to_state": {
      "$ref": "#/$defs/JobState"
    },
    "trace_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "sequence",
    "from_state",
    "to_state",
    "reason_code",
    "actor",
    "trace_id",
    "created_at"
  ],
  "title": "EventMetadata",
  "type": "object"
}
