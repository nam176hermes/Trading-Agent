{
  "$defs": {
    "AlphaCampaignOperation": {
      "enum": [
        "BASELINES",
        "REGISTER_FAMILY",
        "OOS",
        "HOLDOUT",
        "PARITY",
        "PHASE_EXIT"
      ],
      "title": "AlphaCampaignOperation",
      "type": "string"
    },
    "ArtifactRefV1": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "locator": {
          "maxLength": 69,
          "minLength": 69,
          "pattern": "^[0-9a-f]{64}\\.blob$",
          "title": "Locator",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 1099511627776,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "content_sha256",
        "size_bytes",
        "media_type",
        "locator"
      ],
      "title": "ArtifactRefV1",
      "type": "object"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "closure_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Closure Policy Sha256",
          "type": "string"
        },
        "closure_schema_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Closure Schema Version",
          "type": "string"
        },
        "closure_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Closure Sha256",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "tree_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Tree Sha",
          "type": "string"
        }
      },
      "required": [
        "commit_sha",
        "tree_sha",
        "closure_schema_version",
        "closure_policy_sha256",
        "closure_sha256"
      ],
      "title": "SourceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authorization_ref": {
      "$ref": "#/$defs/ArtifactRefV1"
    },
    "expected_source": {
      "$ref": "#/$defs/SourceIdentity"
    },
    "logical_trial_id": {
      "pattern": "^[a-z][a-z0-9._-]{0,127}$",
      "title": "Logical Trial Id",
      "type": "string"
    },
    "manifest_ref": {
      "$ref": "#/$defs/ArtifactRefV1"
    },
    "operation": {
      "$ref": "#/$defs/AlphaCampaignOperation"
    },
    "schema_version": {
      "const": "p3-alpha-campaign-payload-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "operation",
    "manifest_ref",
    "authorization_ref",
    "expected_source",
    "logical_trial_id"
  ],
  "title": "AlphaCampaignPayload",
  "type": "object"
}
