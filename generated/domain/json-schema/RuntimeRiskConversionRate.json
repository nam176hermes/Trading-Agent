{
  "$defs": {
    "Currency": {
      "description": "One immutable identity issued by a versioned currency registry.",
      "enum": [
        "USD",
        "USDT",
        "BTC",
        "ETH"
      ],
      "title": "Currency",
      "type": "string",
      "x-currency-registry-version": "currency-v1"
    }
  },
  "additionalProperties": false,
  "properties": {
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "provenance_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "title": "Provenance Id",
      "type": "string"
    },
    "rate": {
      "pattern": "^(?:0|-?[1-9]\\d*|-?(?:0|[1-9]\\d*)\\.\\d*[1-9])$",
      "title": "Rate",
      "type": "string",
      "x-canonical-decimal-policy": "decimal-v1"
    },
    "source_currency": {
      "$ref": "#/$defs/Currency"
    },
    "target_currency": {
      "$ref": "#/$defs/Currency"
    }
  },
  "required": [
    "source_currency",
    "target_currency",
    "rate",
    "observed_at",
    "provenance_id"
  ],
  "title": "RuntimeRiskConversionRate",
  "type": "object"
}
