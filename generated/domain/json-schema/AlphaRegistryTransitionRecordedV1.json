{
  "additionalProperties": false,
  "properties": {
    "alpha_id": {
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "title": "Alpha Id",
      "type": "string"
    },
    "alpha_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Alpha Version",
      "type": "string"
    },
    "epoch_id": {
      "pattern": "^[a-z][a-z0-9._-]{0,127}$",
      "title": "Epoch Id",
      "type": "string"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "predecessor_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Predecessor Sha256"
    },
    "registry_event_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Registry Event Sha256",
      "type": "string"
    },
    "registry_event_text": {
      "maxLength": 262144,
      "minLength": 2,
      "title": "Registry Event Text",
      "type": "string"
    },
    "registry_sequence": {
      "minimum": 1,
      "title": "Registry Sequence",
      "type": "integer"
    },
    "schema_version": {
      "const": "alpha-registry-transition-recorded-v1",
      "default": "alpha-registry-transition-recorded-v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "epoch_id",
    "alpha_id",
    "alpha_version",
    "registry_sequence",
    "predecessor_sha256",
    "registry_event_sha256",
    "registry_event_text",
    "evidence_sha256"
  ],
  "title": "AlphaRegistryTransitionRecordedV1",
  "type": "object"
}
