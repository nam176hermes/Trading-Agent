{
  "$defs": {
    "Currency": {
      "description": "One immutable identity issued by a versioned currency registry.",
      "enum": [
        "USD",
        "USDT",
        "BTC",
        "ETH"
      ],
      "title": "Currency",
      "type": "string",
      "x-currency-registry-version": "currency-v1"
    },
    "InstrumentId": {
      "description": "A normalized identity whose canonical form includes type and venue.",
      "properties": {
        "product_type": {
          "$ref": "#/$defs/ProductType"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "product_type",
        "venue"
      ],
      "title": "InstrumentId",
      "type": "object"
    },
    "OrderSide": {
      "enum": [
        "buy",
        "sell"
      ],
      "title": "OrderSide",
      "type": "string"
    },
    "OrderStatus": {
      "enum": [
        "created",
        "accepted",
        "rejected",
        "cancelled",
        "partially_filled",
        "filled"
      ],
      "title": "OrderStatus",
      "type": "string"
    },
    "OrderType": {
      "enum": [
        "market",
        "limit"
      ],
      "title": "OrderType",
      "type": "string"
    },
    "Price": {
      "description": "An exact strictly positive monetary price.",
      "properties": {
        "amount": {
          "pattern": "^(?:0|-?[1-9]\\d*|-?(?:0|[1-9]\\d*)\\.\\d*[1-9])$",
          "title": "Amount",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Price",
      "type": "object"
    },
    "ProductType": {
      "description": "Product classes supported by the canonical domain model.",
      "enum": [
        "crypto_spot",
        "equity"
      ],
      "title": "ProductType",
      "type": "string"
    },
    "Quantity": {
      "description": "An exact signed quantity with declared fractional precision.",
      "properties": {
        "precision": {
          "title": "Precision",
          "type": "integer"
        },
        "value": {
          "pattern": "^(?:0|-?[1-9]\\d*|-?(?:0|[1-9]\\d*)\\.\\d*[1-9])$",
          "title": "Value",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1"
        }
      },
      "required": [
        "value",
        "precision"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "TimeInForce": {
      "enum": [
        "day",
        "gtc",
        "ioc",
        "fok"
      ],
      "title": "TimeInForce",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "instrument": {
      "$ref": "#/$defs/InstrumentId"
    },
    "intent_id": {
      "format": "uuid",
      "title": "Intent Id",
      "type": "string"
    },
    "limit_price": {
      "anyOf": [
        {
          "$ref": "#/$defs/Price"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "order_id": {
      "format": "uuid",
      "title": "Order Id",
      "type": "string"
    },
    "order_type": {
      "$ref": "#/$defs/OrderType"
    },
    "quantity": {
      "$ref": "#/$defs/Quantity"
    },
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "side": {
      "$ref": "#/$defs/OrderSide"
    },
    "status": {
      "$ref": "#/$defs/OrderStatus"
    },
    "time_in_force": {
      "$ref": "#/$defs/TimeInForce"
    }
  },
  "required": [
    "instrument",
    "side",
    "order_type",
    "time_in_force",
    "quantity",
    "schema_version",
    "order_id",
    "intent_id",
    "status",
    "occurred_at"
  ],
  "title": "OrderEvent",
  "type": "object"
}
