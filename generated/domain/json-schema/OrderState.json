{
  "$defs": {
    "OrderCancelResolution": {
      "description": "Explicit resolution of an outstanding cancellation request.",
      "enum": [
        "REJECTED"
      ],
      "title": "OrderCancelResolution",
      "type": "string"
    },
    "OrderEvent": {
      "additionalProperties": false,
      "description": "A versioned lifecycle observation ordered solely by sequence.\n\nProducers must carry the required canonical fingerprint. ``create`` is the\nlocal construction path which validates material first and derives it.\n``occurred_at`` records an observation and may move backward under clock\nskew; it is never an ordering authority.",
      "properties": {
        "cancel_resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrderCancelResolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Fingerprint",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "order_id": {
          "format": "uuid",
          "title": "Order Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "const": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "exclusiveMinimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "target_status": {
          "$ref": "#/$defs/OrderStatus"
        }
      },
      "required": [
        "event_id",
        "order_id",
        "sequence",
        "target_status",
        "occurred_at",
        "schema_version",
        "event_fingerprint"
      ],
      "title": "OrderEvent",
      "type": "object"
    },
    "OrderStatus": {
      "enum": [
        "INITIALIZED",
        "SUBMITTED",
        "ACCEPTED",
        "PENDING_UPDATE",
        "PENDING_CANCEL",
        "TRIGGERED",
        "PARTIALLY_FILLED",
        "FILLED",
        "CANCELED",
        "EXPIRED",
        "REJECTED",
        "DENIED"
      ],
      "title": "OrderStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Frozen state whose complete history is replayed on every ingress.",
  "properties": {
    "applied_events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OrderEvent"
      },
      "title": "Applied Events",
      "type": "array"
    },
    "cancel_pending": {
      "default": false,
      "title": "Cancel Pending",
      "type": "boolean"
    },
    "last_sequence": {
      "default": 0,
      "minimum": 0,
      "title": "Last Sequence",
      "type": "integer"
    },
    "order_id": {
      "format": "uuid",
      "title": "Order Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/OrderStatus",
      "default": "INITIALIZED"
    }
  },
  "required": [
    "order_id"
  ],
  "title": "OrderState",
  "type": "object"
}
