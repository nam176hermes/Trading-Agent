{
  "$defs": {
    "OrderEvent": {
      "additionalProperties": false,
      "description": "One immutable order lifecycle observation with canonical content identity.",
      "properties": {
        "event_fingerprint": {
          "default": "",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Event Fingerprint",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "order_id": {
          "format": "uuid",
          "title": "Order Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "exclusiveMinimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "target_status": {
          "$ref": "#/$defs/OrderStatus"
        }
      },
      "required": [
        "event_id",
        "order_id",
        "sequence",
        "target_status",
        "occurred_at",
        "schema_version"
      ],
      "title": "OrderEvent",
      "type": "object"
    },
    "OrderStatus": {
      "enum": [
        "INITIALIZED",
        "SUBMITTED",
        "ACCEPTED",
        "PENDING_UPDATE",
        "PENDING_CANCEL",
        "TRIGGERED",
        "PARTIALLY_FILLED",
        "FILLED",
        "CANCELED",
        "EXPIRED",
        "REJECTED",
        "DENIED"
      ],
      "title": "OrderStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Frozen reducer state containing enough history to detect event-id reuse.",
  "properties": {
    "applied_events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OrderEvent"
      },
      "title": "Applied Events",
      "type": "array"
    },
    "last_sequence": {
      "default": 0,
      "minimum": 0,
      "title": "Last Sequence",
      "type": "integer"
    },
    "order_id": {
      "format": "uuid",
      "title": "Order Id",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/OrderStatus",
      "default": "INITIALIZED"
    }
  },
  "required": [
    "order_id",
    "schema_version"
  ],
  "title": "OrderState",
  "type": "object"
}
