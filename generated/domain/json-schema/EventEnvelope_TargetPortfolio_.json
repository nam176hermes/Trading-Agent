{
  "$defs": {
    "InstrumentId": {
      "description": "A normalized identity whose canonical form includes type and venue.",
      "properties": {
        "product_type": {
          "$ref": "#/$defs/ProductType"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "product_type",
        "venue"
      ],
      "title": "InstrumentId",
      "type": "object"
    },
    "ProductType": {
      "description": "Product classes supported by the canonical domain model.",
      "enum": [
        "crypto_spot",
        "equity"
      ],
      "title": "ProductType",
      "type": "string"
    },
    "TargetPortfolio": {
      "additionalProperties": false,
      "properties": {
        "effective_at": {
          "format": "date-time",
          "title": "Effective At",
          "type": "string"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/TargetPosition"
          },
          "title": "Positions",
          "type": "array"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "source_signal_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Signal Ids",
          "type": "array"
        },
        "target_id": {
          "format": "uuid",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "positions",
        "source_signal_ids",
        "effective_at",
        "schema_version"
      ],
      "title": "TargetPortfolio",
      "type": "object"
    },
    "TargetPosition": {
      "additionalProperties": false,
      "properties": {
        "instrument": {
          "$ref": "#/$defs/InstrumentId"
        },
        "target_weight": {
          "pattern": "^(?:0|-?[1-9]\\d*|-?(?:0|[1-9]\\d*)\\.\\d*[1-9])$",
          "title": "Target Weight",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1"
        }
      },
      "required": [
        "instrument",
        "target_weight"
      ],
      "title": "TargetPosition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "format": "uuid",
      "title": "Causation Id",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "TargetPortfolio",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/TargetPortfolio"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "exclusiveMinimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "stream_id": {
      "format": "uuid",
      "title": "Stream Id",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "stream_id",
    "sequence",
    "observed_at",
    "ingested_at",
    "produced_at",
    "effective_at",
    "expires_at",
    "correlation_id",
    "causation_id",
    "trace_id",
    "payload"
  ],
  "title": "EventEnvelope[TargetPortfolio]",
  "type": "object"
}
