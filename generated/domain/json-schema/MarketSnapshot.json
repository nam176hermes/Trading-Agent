{
  "$defs": {
    "MarketCandle": {
      "additionalProperties": false,
      "description": "One UTC-aligned OHLCV observation for a canonical instrument identity.",
      "properties": {
        "close": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[1-9]\\d{0,127}$",
              "type": "string"
            },
            {
              "maxLength": 129,
              "minLength": 3,
              "pattern": "^[1-9]\\d*\\.\\d*[1-9]$",
              "type": "string"
            },
            {
              "maxLength": 257,
              "minLength": 3,
              "pattern": "^0\\.0{0,127}(?:[1-9]|[1-9]\\d{0,126}[1-9])$",
              "type": "string"
            }
          ],
          "title": "Close",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1",
          "x-market-decimal-policy": "positive-normal-v1"
        },
        "high": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[1-9]\\d{0,127}$",
              "type": "string"
            },
            {
              "maxLength": 129,
              "minLength": 3,
              "pattern": "^[1-9]\\d*\\.\\d*[1-9]$",
              "type": "string"
            },
            {
              "maxLength": 257,
              "minLength": 3,
              "pattern": "^0\\.0{0,127}(?:[1-9]|[1-9]\\d{0,126}[1-9])$",
              "type": "string"
            }
          ],
          "title": "High",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1",
          "x-market-decimal-policy": "positive-normal-v1"
        },
        "instrument": {
          "additionalProperties": false,
          "properties": {
            "product_type": {
              "enum": [
                "crypto_spot",
                "equity"
              ],
              "type": "string"
            },
            "symbol": {
              "maxLength": 32,
              "minLength": 1,
              "pattern": "^[A-Z0-9][A-Z0-9._-]*$",
              "type": "string"
            },
            "venue": {
              "maxLength": 32,
              "minLength": 1,
              "pattern": "^[A-Z0-9][A-Z0-9._-]*$",
              "type": "string"
            }
          },
          "required": [
            "symbol",
            "product_type",
            "venue"
          ],
          "type": "object"
        },
        "low": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[1-9]\\d{0,127}$",
              "type": "string"
            },
            {
              "maxLength": 129,
              "minLength": 3,
              "pattern": "^[1-9]\\d*\\.\\d*[1-9]$",
              "type": "string"
            },
            {
              "maxLength": 257,
              "minLength": 3,
              "pattern": "^0\\.0{0,127}(?:[1-9]|[1-9]\\d{0,126}[1-9])$",
              "type": "string"
            }
          ],
          "title": "Low",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1",
          "x-market-decimal-policy": "positive-normal-v1"
        },
        "open": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[1-9]\\d{0,127}$",
              "type": "string"
            },
            {
              "maxLength": 129,
              "minLength": 3,
              "pattern": "^[1-9]\\d*\\.\\d*[1-9]$",
              "type": "string"
            },
            {
              "maxLength": 257,
              "minLength": 3,
              "pattern": "^0\\.0{0,127}(?:[1-9]|[1-9]\\d{0,126}[1-9])$",
              "type": "string"
            }
          ],
          "title": "Open",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1",
          "x-market-decimal-policy": "positive-normal-v1"
        },
        "open_time": {
          "format": "date-time",
          "title": "Open Time",
          "type": "string"
        },
        "timeframe": {
          "$ref": "#/$defs/MarketTimeframe"
        },
        "volume": {
          "anyOf": [
            {
              "const": "0",
              "type": "string"
            },
            {
              "maxLength": 128,
              "pattern": "^[1-9]\\d{0,127}$",
              "type": "string"
            },
            {
              "maxLength": 129,
              "minLength": 3,
              "pattern": "^[1-9]\\d*\\.\\d*[1-9]$",
              "type": "string"
            },
            {
              "maxLength": 257,
              "minLength": 3,
              "pattern": "^0\\.0{0,127}(?:[1-9]|[1-9]\\d{0,126}[1-9])$",
              "type": "string"
            }
          ],
          "title": "Volume",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1",
          "x-market-decimal-policy": "non-negative-normal-v1"
        }
      },
      "required": [
        "instrument",
        "timeframe",
        "open_time",
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],
      "title": "MarketCandle",
      "type": "object"
    },
    "MarketDataProvenance": {
      "additionalProperties": false,
      "description": "Bounded public-provider provenance with evidence integrity metadata.",
      "properties": {
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "normalization_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Normalization Version",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provider": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
          "title": "Provider",
          "type": "string"
        },
        "raw_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Evidence Sha256",
          "type": "string"
        },
        "schema_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "observed_at",
        "fetched_at",
        "raw_evidence_sha256",
        "schema_version",
        "normalization_version"
      ],
      "title": "MarketDataProvenance",
      "type": "object",
      "x-prohibited-content": [
        "credentials",
        "account-routing",
        "order-text",
        "broker-text",
        "execution-text"
      ]
    },
    "MarketTimeframe": {
      "description": "Closed candle intervals represented by canonical compact names.",
      "enum": [
        "1m",
        "5m",
        "15m",
        "1h",
        "4h",
        "1d"
      ],
      "title": "MarketTimeframe",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A deterministic, provenance-bound canonical market-data observation.",
  "properties": {
    "candles": {
      "items": {
        "$ref": "#/$defs/MarketCandle"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Candles",
      "type": "array"
    },
    "instrument": {
      "additionalProperties": false,
      "properties": {
        "product_type": {
          "enum": [
            "crypto_spot",
            "equity"
          ],
          "type": "string"
        },
        "symbol": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Z0-9][A-Z0-9._-]*$",
          "type": "string"
        },
        "venue": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[A-Z0-9][A-Z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "product_type",
        "venue"
      ],
      "type": "object"
    },
    "known_at": {
      "format": "date-time",
      "title": "Known At",
      "type": "string"
    },
    "normalization_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Normalization Version",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/MarketDataProvenance"
    },
    "schema_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Schema Version",
      "type": "string"
    },
    "timeframe": {
      "$ref": "#/$defs/MarketTimeframe"
    }
  },
  "required": [
    "instrument",
    "timeframe",
    "candles",
    "provenance",
    "known_at",
    "schema_version",
    "normalization_version"
  ],
  "title": "MarketSnapshot",
  "type": "object",
  "x-temporal-invariants": [
    "candles[*].instrument == instrument",
    "candles[*].timeframe == timeframe",
    "candles[*].open_time + timeframe.interval <= provenance.observed_at",
    "provenance.observed_at <= provenance.fetched_at <= known_at",
    "normalization_version == provenance.normalization_version"
  ]
}
