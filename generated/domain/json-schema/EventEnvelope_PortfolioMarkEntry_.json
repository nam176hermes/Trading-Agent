{
  "$defs": {
    "Currency": {
      "description": "One immutable identity issued by a versioned currency registry.",
      "enum": [
        "USD",
        "USDT",
        "BTC",
        "ETH"
      ],
      "title": "Currency",
      "type": "string",
      "x-currency-registry-version": "currency-v1"
    },
    "InstrumentId": {
      "description": "A normalized identity whose canonical form includes type and venue.",
      "properties": {
        "product_type": {
          "$ref": "#/$defs/ProductType"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "product_type",
        "venue"
      ],
      "title": "InstrumentId",
      "type": "object"
    },
    "PortfolioMarkEntry": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Account Id",
          "type": "string"
        },
        "effective_at": {
          "format": "date-time",
          "title": "Effective At",
          "type": "string"
        },
        "instrument": {
          "$ref": "#/$defs/InstrumentId"
        },
        "mark": {
          "$ref": "#/$defs/PositionMark"
        },
        "marked_at": {
          "format": "date-time",
          "title": "Marked At",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "effective_at",
        "schema_version",
        "instrument",
        "mark",
        "marked_at"
      ],
      "title": "PortfolioMarkEntry",
      "type": "object"
    },
    "PositionMark": {
      "additionalProperties": false,
      "properties": {
        "marked_at": {
          "format": "date-time",
          "title": "Marked At",
          "type": "string"
        },
        "price": {
          "$ref": "#/$defs/Price"
        },
        "provenance_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Provenance Id",
          "type": "string"
        }
      },
      "required": [
        "price",
        "marked_at",
        "provenance_id"
      ],
      "title": "PositionMark",
      "type": "object"
    },
    "Price": {
      "description": "An exact strictly positive monetary price.",
      "properties": {
        "amount": {
          "pattern": "^(?:0|-?[1-9]\\d*|-?(?:0|[1-9]\\d*)\\.\\d*[1-9])$",
          "title": "Amount",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Price",
      "type": "object"
    },
    "ProductType": {
      "description": "Product classes supported by the canonical domain model.",
      "enum": [
        "crypto_spot",
        "equity"
      ],
      "title": "ProductType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "format": "uuid",
      "title": "Causation Id",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "PortfolioMarkEntry",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/PortfolioMarkEntry"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "exclusiveMinimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "stream_id": {
      "format": "uuid",
      "title": "Stream Id",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "stream_id",
    "sequence",
    "observed_at",
    "ingested_at",
    "produced_at",
    "effective_at",
    "expires_at",
    "correlation_id",
    "causation_id",
    "trace_id",
    "payload"
  ],
  "title": "EventEnvelope[PortfolioMarkEntry]",
  "type": "object"
}
