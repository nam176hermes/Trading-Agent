{
  "$defs": {
    "EvidenceLocator": {
      "additionalProperties": false,
      "description": "Bounded structural reference without query, userinfo, or free-form text.",
      "properties": {
        "authority": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$",
          "title": "Authority",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceLocatorKind"
        },
        "path": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._~-]{0,63})?$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Path",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "authority",
        "path"
      ],
      "title": "EvidenceLocator",
      "type": "object",
      "x-prohibited-content": [
        "credentials",
        "account-routing",
        "order-type",
        "execution-text"
      ]
    },
    "EvidenceLocatorKind": {
      "description": "Supported locator namespaces; credentials and routing are not locators.",
      "enum": [
        "https",
        "dataset",
        "document",
        "block"
      ],
      "title": "EvidenceLocatorKind",
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/EvidenceLocator"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        }
      },
      "required": [
        "evidence_id",
        "source",
        "locator",
        "observed_at",
        "schema_version"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "EvidenceSource": {
      "description": "Closed research-only source classes with no execution authority.",
      "enum": [
        "market_data",
        "news",
        "filing",
        "on_chain",
        "research"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "InstrumentId": {
      "description": "A normalized identity whose canonical form includes type and venue.",
      "properties": {
        "product_type": {
          "$ref": "#/$defs/ProductType"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "product_type",
        "venue"
      ],
      "title": "InstrumentId",
      "type": "object"
    },
    "ProductType": {
      "description": "Product classes supported by the canonical domain model.",
      "enum": [
        "crypto_spot",
        "equity"
      ],
      "title": "ProductType",
      "type": "string"
    },
    "SignalDirection": {
      "enum": [
        "long",
        "short",
        "flat"
      ],
      "title": "SignalDirection",
      "type": "string"
    },
    "SignalProposal": {
      "additionalProperties": false,
      "description": "Research-only proposal; it intentionally contains no execution authority.",
      "properties": {
        "confidence": {
          "pattern": "^(?:0|0\\.\\d*[1-9]|1)$",
          "title": "Confidence",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1"
        },
        "cutoff_at": {
          "format": "date-time",
          "title": "Cutoff At",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/SignalDirection"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "instrument": {
          "$ref": "#/$defs/InstrumentId"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "research_packet_cutoff_at": {
          "format": "date-time",
          "title": "Research Packet Cutoff At",
          "type": "string"
        },
        "research_packet_id": {
          "format": "uuid",
          "title": "Research Packet Id",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "pattern": "^(?:-1|-0\\.\\d*[1-9]|0|0\\.\\d*[1-9]|1)$",
          "title": "Score",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1"
        },
        "signal_id": {
          "format": "uuid",
          "title": "Signal Id",
          "type": "string"
        },
        "strategy_version": {
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        }
      },
      "required": [
        "signal_id",
        "research_packet_id",
        "instrument",
        "direction",
        "score",
        "confidence",
        "research_packet_cutoff_at",
        "cutoff_at",
        "expires_at",
        "evidence",
        "model_version",
        "strategy_version",
        "schema_version"
      ],
      "title": "SignalProposal",
      "type": "object",
      "x-temporal-invariants": [
        "research_packet_cutoff_at == cutoff_at",
        "evidence.observed_at <= cutoff_at",
        "cutoff_at < expires_at"
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "format": "uuid",
      "title": "Causation Id",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "SignalProposal",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/SignalProposal"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "exclusiveMinimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "stream_id": {
      "format": "uuid",
      "title": "Stream Id",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "stream_id",
    "sequence",
    "observed_at",
    "ingested_at",
    "produced_at",
    "effective_at",
    "expires_at",
    "correlation_id",
    "causation_id",
    "trace_id",
    "payload"
  ],
  "title": "EventEnvelope[SignalProposal]",
  "type": "object"
}
