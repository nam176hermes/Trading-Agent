{
  "$defs": {
    "InstrumentId": {
      "description": "A normalized identity whose canonical form includes type and venue.",
      "properties": {
        "product_type": {
          "$ref": "#/$defs/ProductType"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "product_type",
        "venue"
      ],
      "title": "InstrumentId",
      "type": "object"
    },
    "ProductType": {
      "description": "Product classes supported by the canonical domain model.",
      "enum": [
        "crypto_spot",
        "equity"
      ],
      "title": "ProductType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "instrument": {
      "$ref": "#/$defs/InstrumentId"
    },
    "target_weight": {
      "pattern": "^(?:0|-?[1-9]\\d*|-?(?:0|[1-9]\\d*)\\.\\d*[1-9])$",
      "title": "Target Weight",
      "type": "string",
      "x-canonical-decimal-policy": "decimal-v1"
    }
  },
  "required": [
    "instrument",
    "target_weight"
  ],
  "title": "TargetPosition",
  "type": "object"
}
