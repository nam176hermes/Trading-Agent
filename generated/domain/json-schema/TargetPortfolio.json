{
  "$defs": {
    "InstrumentId": {
      "description": "A normalized identity whose canonical form includes type and venue.",
      "properties": {
        "product_type": {
          "$ref": "#/$defs/ProductType"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "title": "Venue",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "product_type",
        "venue"
      ],
      "title": "InstrumentId",
      "type": "object"
    },
    "ProductType": {
      "description": "Product classes supported by the canonical domain model.",
      "enum": [
        "crypto_spot",
        "equity"
      ],
      "title": "ProductType",
      "type": "string"
    },
    "TargetPosition": {
      "additionalProperties": false,
      "properties": {
        "instrument": {
          "$ref": "#/$defs/InstrumentId"
        },
        "target_weight": {
          "pattern": "^(?:0|-?[1-9]\\d*|-?(?:0|[1-9]\\d*)\\.\\d*[1-9])$",
          "title": "Target Weight",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1"
        }
      },
      "required": [
        "instrument",
        "target_weight"
      ],
      "title": "TargetPosition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "positions": {
      "items": {
        "$ref": "#/$defs/TargetPosition"
      },
      "title": "Positions",
      "type": "array"
    },
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "source_signal_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Signal Ids",
      "type": "array"
    },
    "target_id": {
      "format": "uuid",
      "title": "Target Id",
      "type": "string"
    }
  },
  "required": [
    "target_id",
    "positions",
    "source_signal_ids",
    "effective_at",
    "schema_version"
  ],
  "title": "TargetPortfolio",
  "type": "object"
}
