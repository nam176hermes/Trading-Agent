{
  "$defs": {
    "AccountBalanceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Account Id",
          "type": "string"
        },
        "cash": {
          "$ref": "#/$defs/Money"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "fees": {
          "$ref": "#/$defs/Money"
        },
        "funding": {
          "$ref": "#/$defs/Money"
        },
        "locked_funds": {
          "$ref": "#/$defs/Money"
        },
        "margin_used": {
          "$ref": "#/$defs/Money"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "realized_pnl": {
          "$ref": "#/$defs/Money"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "unrealized_pnl": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "account_id",
        "currency",
        "cash",
        "locked_funds",
        "margin_used",
        "realized_pnl",
        "unrealized_pnl",
        "fees",
        "funding",
        "observed_at",
        "schema_version"
      ],
      "title": "AccountBalanceSnapshot",
      "type": "object"
    },
    "Currency": {
      "description": "One immutable identity issued by a versioned currency registry.",
      "enum": [
        "USD",
        "USDT",
        "BTC",
        "ETH"
      ],
      "title": "Currency",
      "type": "string",
      "x-currency-registry-version": "currency-v1"
    },
    "Money": {
      "description": "An exact signed monetary amount.",
      "properties": {
        "amount": {
          "pattern": "^(?:0|-?[1-9]\\d*|-?(?:0|[1-9]\\d*)\\.\\d*[1-9])$",
          "title": "Amount",
          "type": "string",
          "x-canonical-decimal-policy": "decimal-v1"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "PortfolioOpeningEntry": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
          "title": "Account Id",
          "type": "string"
        },
        "balances": {
          "items": {
            "$ref": "#/$defs/AccountBalanceSnapshot"
          },
          "title": "Balances",
          "type": "array"
        },
        "effective_at": {
          "format": "date-time",
          "title": "Effective At",
          "type": "string"
        },
        "reporting_currency": {
          "$ref": "#/$defs/Currency"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_revision": {
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "effective_at",
        "schema_version",
        "reporting_currency",
        "balances",
        "source_id",
        "source_revision"
      ],
      "title": "PortfolioOpeningEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "format": "uuid",
      "title": "Causation Id",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "PortfolioOpeningEntry",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/PortfolioOpeningEntry"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "exclusiveMinimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "stream_id": {
      "format": "uuid",
      "title": "Stream Id",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "stream_id",
    "sequence",
    "observed_at",
    "ingested_at",
    "produced_at",
    "effective_at",
    "expires_at",
    "correlation_id",
    "causation_id",
    "trace_id",
    "payload"
  ],
  "title": "EventEnvelope[PortfolioOpeningEntry]",
  "type": "object"
}
