{
  "additionalProperties": false,
  "description": "Bounded public-provider provenance with evidence integrity metadata.",
  "properties": {
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "normalization_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Normalization Version",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "provider": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
      "title": "Provider",
      "type": "string"
    },
    "raw_evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Evidence Sha256",
      "type": "string"
    },
    "schema_version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "provider",
    "observed_at",
    "fetched_at",
    "raw_evidence_sha256",
    "schema_version",
    "normalization_version"
  ],
  "title": "MarketDataProvenance",
  "type": "object",
  "x-prohibited-content": [
    "credentials",
    "account-routing",
    "order-text",
    "broker-text",
    "execution-text"
  ]
}
