{
  "$defs": {
    "GlobalHaltReasonCode": {
      "enum": [
        "SAFETY_AUTHORITY_UNKNOWN",
        "KILL_SWITCH_ACTIVE",
        "DAILY_LOSS_LIMIT",
        "DRAWDOWN_LIMIT",
        "RECOVERY_AUTHORIZED",
        "INITIALIZED_SAFE"
      ],
      "title": "GlobalHaltReasonCode",
      "type": "string"
    },
    "GlobalHaltStatus": {
      "enum": [
        "ACTIVE",
        "HALTED"
      ],
      "title": "GlobalHaltStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "next_generation": {
      "exclusiveMinimum": 0,
      "title": "Next Generation",
      "type": "integer"
    },
    "next_status": {
      "$ref": "#/$defs/GlobalHaltStatus"
    },
    "portfolio_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Portfolio Digest",
      "type": "string"
    },
    "prior_generation": {
      "minimum": 0,
      "title": "Prior Generation",
      "type": "integer"
    },
    "prior_transition_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Prior Transition Digest"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/GlobalHaltReasonCode"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "recovery_authorization_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Recovery Authorization Digest"
    },
    "runtime_observation_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Observation Digest",
      "type": "string"
    },
    "runtime_policy_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Runtime Policy Digest",
      "type": "string"
    },
    "safety_observation_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Safety Observation Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "global-halt-transition-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "transition_id": {
      "format": "uuid",
      "title": "Transition Id",
      "type": "string"
    }
  },
  "required": [
    "transition_id",
    "prior_generation",
    "prior_transition_digest",
    "next_generation",
    "next_status",
    "reason_codes",
    "runtime_policy_digest",
    "runtime_observation_digest",
    "portfolio_digest",
    "safety_observation_digest",
    "recovery_authorization_digest",
    "decided_at",
    "schema_version"
  ],
  "title": "GlobalHaltTransition",
  "type": "object"
}
