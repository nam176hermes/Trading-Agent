        "volume_24h": {
          "title": "Volume 24H",
          "type": "number"
        },
        "volume_30d_avg": {
          "title": "Volume 30D Avg",
          "type": "number"
        },
        "volume_trend_ratio": {
          "title": "Volume Trend Ratio",
          "type": "number"
        }
