  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/DecisionAction"
    },
    "asset": {
      "title": "Asset",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "decision_at": {
      "format": "date-time",
      "title": "Decision At",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "price_at_decision": {
      "title": "Price At Decision",
      "type": "number"
    },
    "reflected": {
      "title": "Reflected",
      "type": "boolean"
    },
    "report_snippet": {
      "default": "",
      "title": "Report Snippet",
      "type": "string"
    },
    "signals": {
      "$ref": "#/$defs/DecisionSignals"
    }
  },
  "required": [
    "decision_id",
    "asset",
    "action",
    "confidence",
    "decision_at",
    "price_at_decision",
    "reflected",
    "signals"
