            },
            {
              "type": "null"
            }
          ],
          "title": "Calculated At"
        },
        "close": {
          "title": "Close",
          "type": "number"
        },
        "macd_histogram": {
          "title": "Macd Histogram",
          "type": "number"
        },
        "macd_line": {
          "title": "Macd Line",
          "type": "number"
        },
        "macd_signal_line": {
          "title": "Macd Signal Line",
          "type": "number"
        },
        "price_vs_sma200": {
          "title": "Price Vs Sma200",
          "type": "string"
        },
        "rsi_14": {
          "title": "Rsi 14",
          "type": "number"
        },
        "signal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Signal"
