{"kind": "policy", "name": "job_plane_worker_attempts_select", "roles": ["trading_job_worker"], "using": "(EXISTS ( SELECT 1\n   FROM jobs\n  WHERE jobs.job_id::text = job_attempts.job_id::text AND jobs.job_type::text = 'SNAPSHOT'::text))", "schema": "public", "command": "r", "relation": "job_attempts", "permissive": true, "with_check": null}
