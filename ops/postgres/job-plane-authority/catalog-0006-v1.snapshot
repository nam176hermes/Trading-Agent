{"kind": "policy", "name": "job_plane_scheduler_events_select", "roles": ["trading_job_scheduler"], "using": "(EXISTS ( SELECT 1\n   FROM jobs\n  WHERE jobs.job_id::text = job_events.job_id::text AND jobs.actor_type::text = 'SCHEDULER'::text))", "schema": "public", "command": "r", "relation": "job_events", "permissive": true, "with_check": null}
{"kind": "policy", "name": "job_plane_scheduler_heartbeats_insert", "roles": ["trading_job_scheduler"], "using": null, "schema": "public", "command": "a", "relation": "scheduler_heartbeats", "permissive": true, "with_check": "btrim(scheduler_id::text) <> ''::text AND btrim(actor_id::text) <> ''::text AND (job_id IS NULL OR (EXISTS ( SELECT 1\n   FROM jobs\n  WHERE jobs.job_id::text = scheduler_heartbeats.job_id::text AND jobs.actor_type::text = 'SCHEDULER'::text AND jobs.actor_id::text = scheduler_heartbeats.actor_id::text)))"}
{"kind": "policy", "name": "job_plane_scheduler_jobs_select", "roles": ["trading_job_scheduler"], "using": "job_type::text = 'SNAPSHOT'::text AND actor_type::text = 'SCHEDULER'::text AND priority = 0 AND idempotency_key::text ~ '^schedule:snapshot:[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]Z$'::text AND pg_input_is_valid(\"substring\"(idempotency_key::text, '^schedule:snapshot:([0-9]{4}-[0-9]{2}-[0-9]{2})T'::text), 'date'::text)", "schema": "public", "command": "r", "relation": "jobs", "permissive": true, "with_check": null}
