[Unit]
Description=Trading Agent Phase 4B durable snapshot enqueue tick
Wants=network.target
After=network.target trading-job-api.service

[Service]
Type=oneshot
WorkingDirectory=/opt/trading-agent-phase4/releases/app-fdc085a05019d700ccbce59370941e2c97ef899a
EnvironmentFile=/etc/trading-agent/job-scheduler.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/trading-agent-phase4/releases/app-fdc085a05019d700ccbce59370941e2c97ef899a
Environment=TRADING_MODE=paper
Environment=LIVE_EXECUTION_ENABLED=false
Environment=LIVE_TRADING_APPROVED=false
ExecStart=/opt/trading-agent-phase4/releases/app-fdc085a05019d700ccbce59370941e2c97ef899a/.venv/bin/python3.11 -m services.job_scheduler.main
RemainAfterExit=no
TimeoutStartSec=30s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
