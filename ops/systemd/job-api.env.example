# Copy outside Git to /etc/trading-agent/job-api.env with mode 0600.
TRADING_DATABASE_HOST=127.0.0.1
TRADING_DATABASE_PORT=<localhost-postgresql-port>
TRADING_DATABASE_NAME=<database-name>
TRADING_DATABASE_USER=<dedicated-non-owner-job-api-role>
TRADING_DATABASE_PASSWORD=<provision-outside-git>
TRADING_JOB_API_TOKEN=<provision-outside-git>
TRADING_JOB_API_PRINCIPAL_TYPE=OPERATOR
TRADING_JOB_API_PRINCIPAL_ID=dashboard-service
TRADING_JOB_API_EXPECTED_REVISION=0011_engine_backtest_worker_authority
TRADING_MODE=paper
LIVE_EXECUTION_ENABLED=false
LIVE_TRADING_APPROVED=false
