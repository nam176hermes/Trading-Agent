[Unit]
Description=Trading Agent Phase 4B protected semantic-input refresh

[Service]
Type=oneshot
WorkingDirectory=/opt/trading-agent-phase4/releases/app-fdc085a05019d700ccbce59370941e2c97ef899a
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/trading-agent-phase4/releases/app-fdc085a05019d700ccbce59370941e2c97ef899a
Environment=TRADING_MODE=paper
Environment=LIVE_EXECUTION_ENABLED=false
Environment=LIVE_TRADING_APPROVED=false
ExecStart=/opt/trading-agent-phase4/releases/app-fdc085a05019d700ccbce59370941e2c97ef899a/.venv/bin/python3.11 -m services.semantic_input_refresher.main --apply
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/thenam176/.hermes/crypto-research/reports
BindReadOnlyPaths=/home/thenam176/.hermes/crypto-research/memory/macro
BindPaths=/home/thenam176/.local/share/trading-agent/research-input
BindPaths=/etc/trading-agent/research-input-manifests
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
# Narrow exception: the root refresher reads UID 1000 private structured
# sources and atomically chowns/chmods the six published read-only files.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_CHOWN CAP_FOWNER CAP_DAC_READ_SEARCH
