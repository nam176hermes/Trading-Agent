# Copy outside Git to /etc/trading-agent/job-worker.env with mode 0600.
TRADING_DATABASE_HOST=127.0.0.1
TRADING_DATABASE_PORT=<localhost-postgresql-port>
TRADING_DATABASE_NAME=<database-name>
TRADING_DATABASE_USER=<dedicated-non-owner-worker-role>
TRADING_DATABASE_PASSWORD=<provision-outside-git>
TRADING_WORKER_ID=<stable-instance-id>
TRADING_WORKER_IDLE_SECONDS=1
TRADING_RESEARCH_ANTHROPIC_API_KEY=<optional-dedicated-research-credential>
TRADING_RESEARCH_DEEPSEEK_API_KEY=<optional-dedicated-research-credential>
TRADING_RESEARCH_EXA_API_KEY=<optional-dedicated-research-credential>
TRADING_RESEARCH_OPENAI_API_KEY=<optional-dedicated-research-credential>
TRADING_MODE=paper
LIVE_EXECUTION_ENABLED=false
LIVE_TRADING_APPROVED=false
