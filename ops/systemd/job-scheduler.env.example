# Copy outside Git to /etc/trading-agent/job-scheduler.env with mode 0600.
TRADING_DATABASE_HOST=127.0.0.1
TRADING_DATABASE_PORT=<localhost-postgresql-port>
TRADING_DATABASE_NAME=<database-name>
TRADING_DATABASE_USER=<dedicated-non-owner-scheduler-role>
TRADING_DATABASE_PASSWORD=<provision-outside-git>
TRADING_SCHEDULER_ID=<stable-instance-id>
TRADING_SCHEDULER_ACTOR_ID=<scheduler-actor-id>
TRADING_CODE_COMMIT=<phase-4-release-commit>
TRADING_MODE=paper
LIVE_EXECUTION_ENABLED=false
LIVE_TRADING_APPROVED=false
