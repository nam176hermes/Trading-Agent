[Unit]
Description=Trading Agent Phase 4B single durable research worker
Wants=network.target
Requires=trading-safety-state-export.service
After=network.target trading-job-api.service trading-safety-state-export.service

[Service]
Type=simple
WorkingDirectory=/opt/trading-agent-phase4/releases/app-fdc085a05019d700ccbce59370941e2c97ef899a
EnvironmentFile=/etc/trading-agent/job-worker.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/trading-agent-phase4/releases/app-fdc085a05019d700ccbce59370941e2c97ef899a
Environment=TRADING_MODE=paper
Environment=LIVE_EXECUTION_ENABLED=false
Environment=LIVE_TRADING_APPROVED=false
ExecStart=/opt/trading-agent-phase4/releases/app-fdc085a05019d700ccbce59370941e2c97ef899a/.venv/bin/python3.11 -m services.job_worker.main
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=control-group
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/opt/trading-agent-phase4/releases/app-fdc085a05019d700ccbce59370941e2c97ef899a
BindReadOnlyPaths=/opt/trading-agent-phase4/releases/backend-41f055b48033714c660f44cc20498b7545366e75
BindReadOnlyPaths=/opt/trading-agent-phase4/manifests
BindReadOnlyPaths=/etc/trading-agent/phase4-runtime-authority.json
BindReadOnlyPaths=/etc/trading-agent/research-input-manifests
BindReadOnlyPaths=/home/thenam176/.local/share/trading-agent/research-input
BindReadOnlyPaths=/run/user/1000/trading-agent
BindPaths=/home/thenam176/.local/share/trading-agent/job-artifacts
BindPaths=/home/thenam176/.local/share/trading-agent/research-output/reports
BindPaths=/home/thenam176/.local/share/trading-agent/research-output/signals
BindPaths=/home/thenam176/.local/run/trading-agent/research-home
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=default.target
