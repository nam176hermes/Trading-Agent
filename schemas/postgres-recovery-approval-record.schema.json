      "additionalProperties": false,
      "minProperties": 5,
      "maxProperties": 5,
      "required": [
        "trading_safety_observed_at_utc",
        "job_plane_observed_at_utc",
        "database_incident_observed_date",
        "evidence_status",
        "current_revalidation"
      ],
      "properties": {
        "trading_safety_observed_at_utc": {
          "const": "2026-07-11T23:46:34Z",
          "type": "string"
        },
        "job_plane_observed_at_utc": {
          "const": "2026-07-16T15:12:29Z",
          "type": "string"
        },
        "database_incident_observed_date": {
          "const": "2026-07-16",
          "type": "string"
        },
        "evidence_status": {
          "enum": [
            "HISTORICAL_READ_ONLY_NOT_CURRENT",
            "CURRENT_REVIEW_COMPLETE"
          ],
          "type": "string"
        },
        "current_revalidation": { "$ref": "#/$defs/placeholderOrTimestamp" }
      }
    },
    "safety_baseline": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 10,
      "maxProperties": 10,
      "required": [
        "requested_mode",
        "effective_mode",
        "kill_switch",
        "orders_count",
        "trades_count",
        "job_api_state",
        "job_worker_state",
        "job_scheduler_state",
        "job_scheduler_timer_state",
        "port_8401_state"
