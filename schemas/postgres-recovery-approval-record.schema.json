      "properties": {
        "alembic_head": {
          "const": "0003_contract_lineage_repair_OR_0004_durable_research_jobs",
          "type": "string"
        },
        "canonical_rows": { "const": "43055", "type": "string" },
        "quarantine_rows": { "const": "222", "type": "string" },
        "jobs_count": { "const": "0", "type": "string" },
        "job_attempts_count": { "const": "0", "type": "string" },
        "job_events_count": { "const": "0", "type": "string" },
        "scheduler_heartbeats_count": { "const": "0", "type": "string" },
        "job_artifacts_count": { "const": "0", "type": "string" },
        "worker_heartbeats_count": { "const": "0", "type": "string" }
      }
    },
    "stale_pid_evidence": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 5,
      "maxProperties": 5,
