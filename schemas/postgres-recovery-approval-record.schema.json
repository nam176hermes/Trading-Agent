{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-agent.invalid/schemas/postgres-recovery-approval-record.schema.json",
  "title": "PostgreSQL recovery approval preparation record",
  "description": "A permanently non-authorizing preparation envelope. It is never an executable APPROVAL_RECORD.",
  "$comment": "Files use the deterministic JSON-compatible subset of YAML 1.2. Historical observations and current reviewer-required outcomes are explicit outside the exact transcript. The validator additionally enforces raw transcript member order, cross-field constraints, time windows, and local integrity bindings.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 16,
  "maxProperties": 16,
  "required": [
    "document_kind",
    "format_version",
    "record_id",
    "authorization_state",
    "evidence_age",
    "safety_baseline",
    "expected_pre_recovery",
    "stale_pid_evidence",
    "recovery_review",
    "procedure_references",
    "backup_restore_controls",
    "target",
    "preflight",
    "integrity",
    "transcript",
    "authorization_notice"
  ],
  "x-runbook-source": "docs/production/runbooks/postgresql-preserve-recover.md#4-exact-dual-reviewed-execution-transcript",
  "x-runbook-transcript-order": [
    "DECISION",
    "CHANGE_ID",
    "INCIDENT_ID",
    "CHANGE_ARTIFACT",
    "CHANGE_ARTIFACT_SHA256",
    "APPROVED_AT_UTC",
    "EXPIRES_AT_UTC",
    "OPERATOR_NAME",
    "REVIEWER_NAME",
    "OPERATOR_ATTESTATION",
    "REVIEWER_ATTESTATION",
    "RUN_ID",
    "RUNBOOK_SHA256",
    "SOURCE_COMMIT",
    "SOURCE_TREE",
    "MIGRATION_SHA256",
    "EXPECTED_CATALOG_SHA256",
    "EXPECTED_CATALOG_QUERY_ID",
    "EXPECTED_CATALOG_PROVENANCE",
    "EXPECTED_CATALOG_REVIEW_ATTESTATION",
    "ORIG_SYSTEM_ID",
    "ORIG_PGDATA_NLINK",
    "ORIG_SOCKET_NLINK",
    "ORIG_LOG_DIR_NLINK",
    "ORIG_LOG_NLINK",
    "EVIDENCE_PARENT",
    "PRESERVE_PARENT",
    "BACKUP_PARENT",
    "SECRET_PARENT",
    "ISO_HOST",
    "ISO_PORT",
    "ISO_ADMIN_DB",
    "ISO_RESTORE_DB",
    "ISO_PGDATA",
    "ISO_SYSTEM_ID",
    "ISO_SOCKET",
    "ISO_ADMIN_ENV",
    "ALLOW_STOP_ALL_LISTED_UNITS",
    "ALLOW_OFFLINE_COLD_COPY",
    "ALLOW_ONE_ORIGINAL_START",
    "ALLOW_ONE_ORIGINAL_STOP",
    "ALLOW_READ_ONLY_VERIFICATION",
    "ALLOW_IMMEDIATE_LOGICAL_BACKUP",
    "ALLOW_MIGRATE_ORIGINAL_IF_0003",
    "ALLOW_ISOLATED_RESTORE",
    "ACCEPT_INTERRUPTED_SHUTDOWN",
    "ACCEPT_CHECKSUMS_DISABLED",
    "ACKNOWLEDGE_NO_PITR",
    "RECOVERY_LOG_POLICY_ID",
    "ORIGINAL_START_POLICY_ID"
  ],
  "$defs": {
    "placeholder": {
      "const": "REQUIRES_REVIEWER_INPUT",
      "type": "string"
    },
    "placeholderOrTimestamp": {
      "anyOf": [
        { "$ref": "#/$defs/placeholder" },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      ]
    },
    "placeholderOrSha256": {
      "anyOf": [
        { "$ref": "#/$defs/placeholder" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "placeholderOrGitObject": {
      "anyOf": [
        { "$ref": "#/$defs/placeholder" },
        { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      ]
    },
    "placeholderOrAbsolutePath": {
      "anyOf": [
        { "$ref": "#/$defs/placeholder" },
        { "type": "string", "pattern": "^/[ -~]*$" }
      ]
    },
    "placeholderOrSystemId": {
      "anyOf": [
        { "$ref": "#/$defs/placeholder" },
        { "type": "string", "pattern": "^[0-9]{10,24}$" }
      ]
    },
    "placeholderOrPositiveInteger": {
      "anyOf": [
        { "$ref": "#/$defs/placeholder" },
        { "type": "string", "pattern": "^[1-9][0-9]*$" }
      ]
    },
    "placeholderOrYes": {
      "anyOf": [
        { "$ref": "#/$defs/placeholder" },
        { "const": "YES", "type": "string" }
      ]
    },
    "placeholderOrBooleanString": {
      "anyOf": [
        { "$ref": "#/$defs/placeholder" },
        { "enum": ["true", "false"], "type": "string" }
      ]
    }
  },
