      "properties": {
        "requested_mode": { "const": "paper", "type": "string" },
        "effective_mode": { "const": "paper", "type": "string" },
        "kill_switch": { "const": "INACTIVE", "type": "string" },
        "orders_count": { "const": "30", "type": "string" },
        "trades_count": { "const": "0", "type": "string" },
        "job_api_state": { "const": "INACTIVE", "type": "string" },
        "job_worker_state": { "const": "INACTIVE", "type": "string" },
