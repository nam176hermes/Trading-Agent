      "minProperties": 9,
      "maxProperties": 9,
      "required": [
        "alembic_head",
        "canonical_rows",
        "quarantine_rows",
        "jobs_count",
        "job_attempts_count",
        "job_events_count",
        "scheduler_heartbeats_count",
        "job_artifacts_count",
        "worker_heartbeats_count"
