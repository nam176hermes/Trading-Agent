{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-agent.invalid/schemas/package6-paper-runtime-approval.schema.json",
  "title": "Package 6 paper runtime approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "schema_version", "record_id", "scope", "source", "validity", "review", "operations", "source_bindings", "constraints", "postgres_authority", "fixture_authority", "request", "authority_digests", "canonical_record_sha256"],
  "properties": {
    "record_kind": {"const": "PACKAGE6_PAPER_RUNTIME_APPROVAL"},
    "schema_version": {"const": 2},
    "record_id": {"type": "string", "pattern": "^PACKAGE6_RUNTIME_[A-Z0-9_-]{1,80}$"},
    "scope": {"const": "PACKAGE6_PAPER_RUNTIME"},
    "source": {"type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": {"commit": {"$ref": "#/$defs/git"}, "tree": {"$ref": "#/$defs/git"}}},
    "validity": {"type": "object", "additionalProperties": false, "required": ["approved_at_utc", "expires_at_utc"], "properties": {"approved_at_utc": {"$ref": "#/$defs/time"}, "expires_at_utc": {"$ref": "#/$defs/time"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["decision", "operator_identity", "reviewer_identity", "runtime_greenlight"], "properties": {"decision": {"const": "APPROVED"}, "operator_identity": {"$ref": "#/$defs/identity"}, "reviewer_identity": {"$ref": "#/$defs/identity"}, "runtime_greenlight": {"const": "APPROVE PACKAGE 6 RUNTIME"}}},
    "operations": {"type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/operation"}},
    "source_bindings": {"type": "array", "minItems": 76, "maxItems": 76, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+$"}, "sha256": {"$ref": "#/$defs/sha"}}}},
    "constraints": {"type": "object", "additionalProperties": false, "required": ["disposable_root", "evidence_root", "max_processes", "startup_timeout_seconds", "operation_timeout_seconds", "cleanup_timeout_seconds", "max_output_bytes", "live_execution_approved", "live_trading_approved", "systemd_allowed", "persistent_services_allowed", "network_policy"], "properties": {"disposable_root": {"$ref": "#/$defs/tmp"}, "evidence_root": {"$ref": "#/$defs/tmp"}, "max_processes": {"type": "integer", "minimum": 1, "maximum": 4}, "startup_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60}, "operation_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}, "cleanup_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60}, "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576}, "live_execution_approved": {"const": false}, "live_trading_approved": {"const": false}, "systemd_allowed": {"const": false}, "persistent_services_allowed": {"const": false}, "network_policy": {"const": "LOOPBACK_ONLY"}}},
    "postgres_authority": {"type": "object", "additionalProperties": false, "required": ["approval_sha256", "bind_host", "port", "database_name", "pgdata", "cluster_name", "service_roles"], "properties": {"approval_sha256": {"$ref": "#/$defs/sha"}, "bind_host": {"const": "127.0.0.1"}, "port": {"type": "integer", "minimum": 1024, "maximum": 65535}, "database_name": {"const": "trading_agent_disposable_test"}, "pgdata": {"$ref": "#/$defs/tmp"}, "cluster_name": {"const": "trading-agent-disposable-tests"}, "service_roles": {"const": ["trading_job_api", "trading_job_worker"]}}},
    "fixture_authority": {"type": "object", "additionalProperties": false, "required": ["fixture_sha256", "provenance", "path"], "properties": {"fixture_sha256": {"$ref": "#/$defs/sha"}, "provenance": {"const": "DETERMINISTIC_PROVIDER_FREE_V1"}, "path": {"$ref": "#/$defs/tmp"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["job_type", "actor", "idempotency_key", "expected_job_count"], "properties": {"job_type": {"const": "SNAPSHOT"}, "actor": {"const": "FOUNDATION_VALIDATION"}, "idempotency_key": {"type": "string", "pattern": "^foundation:manual:snapshot:[a-z0-9][a-z0-9._-]{2,80}$"}, "expected_job_count": {"const": 1}}},
    "authority_digests": {"type": "object", "additionalProperties": false, "required": ["release", "application", "backend", "command", "semantic", "fixture", "safety"], "properties": {"release": {"$ref": "#/$defs/sha"}, "application": {"$ref": "#/$defs/sha"}, "backend": {"$ref": "#/$defs/sha"}, "command": {"$ref": "#/$defs/sha"}, "semantic": {"$ref": "#/$defs/sha"}, "fixture": {"$ref": "#/$defs/sha"}, "safety": {"$ref": "#/$defs/sha"}}},
    "canonical_record_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "git": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]{2,127}$"},
    "tmp": {"type": "string", "pattern": "^/tmp/(?:[A-Za-z0-9._-]+/?)+$"},
    "operation": {"type": "object", "additionalProperties": false, "required": ["operation_id", "action", "component", "argv", "cwd", "bind_host", "port", "executable_sha256"], "properties": {"operation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}, "action": {"enum": ["START", "STOP"]}, "component": {"enum": ["JOB_API", "WORKER"]}, "argv": {"type": "array", "minItems": 0, "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}}, "cwd": {"$ref": "#/$defs/tmp"}, "bind_host": {"type": ["string", "null"]}, "port": {"type": ["integer", "null"]}, "executable_sha256": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}}}
  }
}
