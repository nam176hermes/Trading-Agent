{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trading-agent.invalid/schemas/disposable-postgres-test-approval.schema.json",
  "title": "Disposable PostgreSQL test approval record",
  "description": "Exact external authority for one commit-bound disposable PostgreSQL test scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "record_id",
    "scope",
    "source",
    "validity",
    "review",
    "approved_operations",
    "source_bindings",
    "constraints",
    "red_sql_binding",
    "canonical_record_sha256"
  ],
  "properties": {
    "record_kind": {
      "const": "DISPOSABLE_POSTGRES_TEST_APPROVAL"
    },
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^DISPOSABLE_POSTGRES_TEST_[A-Z0-9_-]{1,80}$"
    },
    "scope": {
      "enum": ["DISPOSABLE_PG_RED", "DISPOSABLE_PG_GREEN"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"$ref": "#/$defs/gitObject"},
        "tree": {"$ref": "#/$defs/gitObject"}
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_at_utc", "expires_at_utc"],
      "properties": {
        "approved_at_utc": {"$ref": "#/$defs/timestamp"},
        "expires_at_utc": {"$ref": "#/$defs/timestamp"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "operator_identity", "reviewer_identity"],
      "properties": {
        "decision": {"const": "APPROVED"},
        "operator_identity": {"$ref": "#/$defs/identity"},
        "reviewer_identity": {"$ref": "#/$defs/identity"}
      }
    },
    "approved_operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_path", "operation_id"],
        "properties": {
          "test_path": {
            "type": "string",
            "pattern": "^tests/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\\.py$"
          },
          "operation_id": {"$ref": "#/$defs/operationId"}
        }
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "prefixItems": [
        {"$ref": "#/$defs/sourceBinding0001"},
        {"$ref": "#/$defs/sourceBinding0002"},
        {"$ref": "#/$defs/sourceBinding0003"},
        {"$ref": "#/$defs/sourceBinding0004"},
        {"$ref": "#/$defs/sourceBinding0005"},
        {"$ref": "#/$defs/sourceBinding0006"},
        {"$ref": "#/$defs/sourceBinding0007"},
        {"$ref": "#/$defs/sourceBinding0008"},
        {"$ref": "#/$defs/sourceBinding0009"},
        {"$ref": "#/$defs/sourceBinding0010"},
        {"$ref": "#/$defs/sourceBinding0011"},
        {"$ref": "#/$defs/sourceBinding0012"},
        {"$ref": "#/$defs/sourceBinding0013"},
        {"$ref": "#/$defs/sourceBinding0014"},
        {"$ref": "#/$defs/sourceBinding0015"},
        {"$ref": "#/$defs/sourceBinding0016"},
        {"$ref": "#/$defs/sourceBinding0017"},
        {"$ref": "#/$defs/sourceBinding0018"},
        {"$ref": "#/$defs/sourceBinding0019"},
        {"$ref": "#/$defs/sourceBinding0020"},
        {"$ref": "#/$defs/sourceBinding0021"},
        {"$ref": "#/$defs/sourceBinding0022"},
        {"$ref": "#/$defs/sourceBinding0023"},
        {"$ref": "#/$defs/sourceBinding0024"},
        {"$ref": "#/$defs/sourceBinding0025"},
        {"$ref": "#/$defs/sourceBinding0026"},
        {"$ref": "#/$defs/sourceBinding0027"},
        {"$ref": "#/$defs/sourceBinding0028"},
        {"$ref": "#/$defs/sourceBinding0029"},
        {"$ref": "#/$defs/sourceBinding0030"},
        {"$ref": "#/$defs/sourceBinding0031"},
        {"$ref": "#/$defs/sourceBinding0032"},
        {"$ref": "#/$defs/sourceBinding0033"},
        {"$ref": "#/$defs/sourceBindingJobRoles"},
        {"$ref": "#/$defs/sourceBindingP3Roles"},
        {"$ref": "#/$defs/sourceBindingRoles"}
      ],
      "items": false
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pgdata_prefix",
        "bind_host",
        "port_allocation",
        "forbidden_ports",
        "cluster_name",
        "database_name",
        "runtime_settings_policy"
      ],
      "properties": {
        "pgdata_prefix": {"const": "/tmp/phase4-postgres-"},
        "bind_host": {"const": "127.0.0.1"},
        "port_allocation": {"const": "EXPLICITLY_APPROVED"},
        "forbidden_ports": {
          "type": "array",
          "prefixItems": [
            {"const": 3002},
            {"const": 8401},
            {"const": 55432}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "cluster_name": {"const": "trading-agent-disposable-tests"},
        "database_name": {"const": "trading_agent_disposable_test"},
        "runtime_settings_policy": {"const": "REJECT_IF_PRESENT"}
      }
    },
    "red_sql_binding": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "sql_path", "sql_sha256"],
          "properties": {
            "operation_id": {"$ref": "#/$defs/operationId"},
            "sql_path": {
              "type": "string",
              "pattern": "^(?:tests|ops)/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\\.sql$"
            },
            "sql_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "canonical_record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "identity": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@-]*$",
      "not": {
        "enum": [
          "CHANGEME",
          "PLACEHOLDER",
          "REQUIRES_REVIEWER_INPUT",
          "TBD",
          "TODO",
          "UNKNOWN"
        ]
      }
    },
    "operationId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sourceBindingBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceBinding0001": {
      "allOf": [
        {"$ref": "#/$defs/sourceBindingBase"},
        {"properties": {"path": {"const": "alembic/versions/0001_phase3_operational_store.py"}}}
      ]
    },
    "sourceBinding0002": {
      "allOf": [
        {"$ref": "#/$defs/sourceBindingBase"},
        {"properties": {"path": {"const": "alembic/versions/0002_quarantine_lineage.py"}}}
      ]
    },
    "sourceBinding0003": {
      "allOf": [
        {"$ref": "#/$defs/sourceBindingBase"},
        {"properties": {"path": {"const": "alembic/versions/0003_contract_lineage_repair.py"}}}
      ]
    },
    "sourceBinding0004": {
      "allOf": [
        {"$ref": "#/$defs/sourceBindingBase"},
        {"properties": {"path": {"const": "alembic/versions/0004_durable_research_jobs.py"}}}
      ]
    },
    "sourceBinding0005": {
      "allOf": [
        {"$ref": "#/$defs/sourceBindingBase"},
        {"properties": {"path": {"const": "alembic/versions/0005_job_plane_role_split.py"}}}
      ]
    },
