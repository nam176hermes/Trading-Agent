      ]
    },
    "sourceBinding0009": {
      "allOf": [
        {"$ref": "#/$defs/sourceBindingBase"},
        {"properties": {"path": {"const": "alembic/versions/0009_canonical_market_data.py"}}}
      ]
    },
    "sourceBinding0010": {
      "allOf": [
        {"$ref": "#/$defs/sourceBindingBase"},
        {"properties": {"path": {"const": "alembic/versions/0010_engine_event_ledger.py"}}}
      ]
    },
    "sourceBinding0011": {
      "allOf": [
        {"$ref": "#/$defs/sourceBindingBase"},
