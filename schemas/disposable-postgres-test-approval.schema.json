  },
  "allOf": [
    {
      "if": {
        "properties": {"scope": {"const": "DISPOSABLE_PG_GREEN"}},
        "required": ["scope"]
      },
      "then": {
        "properties": {"red_sql_binding": {"type": "null"}}
      }
    }
  ]
