    "sourceBinding0018": {
      "allOf": [
        {"$ref": "#/$defs/sourceBindingBase"},
        {"properties": {"path": {"const": "alembic/versions/0018_p1_paper_closure_rotation.py"}}}
      ]
    },
    "sourceBinding0019": {
      "allOf": [
        {"$ref": "#/$defs/sourceBindingBase"},
        {"properties": {"path": {"const": "alembic/versions/0019_p2_security_master.py"}}}
